{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "System Activity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Events/min", "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "pointSize": 5 },
          "unit": "opm"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "Events per Minute",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(dsts_events_generated_total[1m]) * 60",
          "legendFormat": "{{building_id}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Events per Building",
      "type": "timeseries",
      "targets": [
        {
          "expr": "dsts_events_processed_total",
          "legendFormat": "{{building_id}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Inter-Building Transitions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "dsts_inter_building_transitions_total",
          "legendFormat": "{{source_building}} → {{dest_building}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Recognition",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 4,
      "title": "Recognition Success Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "dsts_recognition_accuracy",
          "legendFormat": "{{building_id}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 10 },
      "id": 5,
      "title": "Recognition Successes vs Failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "dsts_recognition_successes_total",
          "legendFormat": "Successes ({{building_id}})"
        },
        {
          "expr": "dsts_recognition_failures_total",
          "legendFormat": "Failures ({{building_id}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 10 },
      "id": 6,
      "title": "Recognition Probability Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(dsts_recognition_probability_bucket[5m]))",
          "legendFormat": "Median"
        },
        {
          "expr": "histogram_quantile(0.95, rate(dsts_recognition_probability_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Routing",
