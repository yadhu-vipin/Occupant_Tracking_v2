# python
__pycache__/
*.py[cod]
.venv/

# the shared corpus -- large, drop-in by whoever runs this
corpus/*.npy
corpus/*.csv

# per-building node embeddings -- biometric data, regenerated by generate_nodes.py
nodes/**/embeddings/*.npy
nodes/**/__pycache__/
nodes/**/*.db-journal
nodes/**/*.db-wal
nodes/**/*.db-shm
recognition/output/*.json
retrieval/output/*.json
centralized/output/*.json
events/output/*.json
dsts/output/*.json
evaluate_pipeline/output/*.json

# scratch topology-scaling experiments (2/5-building regroupings for comparison)
variants/
Occupant_Tracking_v2-lane-d-final/

# Prometheus scrape credential (must match DSTS_METRICS_TOKEN)
monitoring/metrics_token

# local tooling state
.claude/worktrees/
.claude/scheduled_tasks.lock

# generated per-seed runs (population, galleries, filters, events, results) -- python manage.py run --seeds N
runs/
# generated by older layouts; now written under runs/seed_XX/
nodes/
out/
reports/
evaluate_pipeline/
